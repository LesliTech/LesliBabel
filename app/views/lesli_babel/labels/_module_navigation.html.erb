<%
selected_module_id = @module&.id || @label&.engine_id || params[:modules_id].presence&.to_i
items = LesliBabel::Module.order(:code).map do |engine|
    {
        label: engine.code.titleize,
        path: module_path(engine),
        selected: selected_module_id == engine.id
    }
end
%>
<%= render LesliView::Layout::NavigationSidebar.new(
    items: items,
    label: t("lesli_babel.navigation.modules"),
    empty_selection_label: t("lesli_babel.navigation.all_modules")
) %>
