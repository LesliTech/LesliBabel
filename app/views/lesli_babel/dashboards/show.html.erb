
<%= render(LesliView::Layout::Container.new("babel-dashboard")) do %>

    <%= render(LesliView::Components::Header.new(
        "Translations dashboard",
        "Tracking #{@stats[:total_labels]} labels across #{@stats.dig(:summary, :configured_locales)} locales with #{@stats.dig(:summary, :coverage)}% global coverage."
    )) do %>
        <%= render(LesliView::Elements::Button.new(
            "#{@stats.dig(:summary, :pending_translations)} pending translations",
            solid: false,
            icon: "translate",
            url: labels_path(missing: true)
        )) %>
        <%= render "lesli_babel/partials/deploy_button" %>
    <% end %>

    <%= render(LesliView::Components::Toolbar.new) %>

    <section class="grid gap-4 py-6 sm:grid-cols-2 lg:grid-cols-3" aria-label="Labels requiring attention">
        <% {
            "Need translation" => @stats.dig(:attention, :need_translation),
            "Need help" => @stats.dig(:attention, :need_help),
            "Need context" => @stats.dig(:attention, :need_context)
        }.each do |label, total| %>
            <article class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
                <p class="text-sm font-medium text-slate-600"><%= label %></p>
                <p class="mt-2 text-3xl font-semibold tabular-nums text-slate-900"><%= total %></p>
            </article>
        <% end %>
    </section>

    <section class="py-6 sm:py-8" aria-label="Translation status by locale">
        <div class="grid gap-5 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">
            <% @stats[:locales].each do |locale| %>
                <%= link_to labels_path(locale: locale[:code], missing: true),
                    class: "group flex flex-col items-center rounded-2xl border border-slate-200 bg-white p-5 text-center shadow-sm transition hover:border-sky-300 hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-600 focus-visible:ring-offset-2 sm:p-6",
                    aria: { label: "#{locale[:name]}: #{locale[:coverage]}% coverage, #{locale[:missing]} pending translations. View pending translations." },
                    data: { turbo_frame: "_top" } do %>
                    <svg class="mb-3 h-12 w-16" aria-hidden="true">
                        <use xlink:href="#locale-<%= locale[:code] %>"></use>
                    </svg>
                    <h2 class="text-base font-medium text-slate-800">
                        <%= locale[:name] %>
                    </h2>
                    <dl class="mt-3 grid w-full grid-cols-2 gap-3 text-sm">
                        <div>
                            <dt class="text-slate-600">Translated</dt>
                            <dd class="font-semibold tabular-nums text-slate-900"><%= locale[:completed] %></dd>
                        </div>
                        <div>
                            <dt class="text-slate-600">Pending</dt>
                            <dd class="font-semibold tabular-nums text-slate-900"><%= locale[:missing] %></dd>
                        </div>
                    </dl>
                    <div class="mt-4 w-full">
                        <div class="mb-2 flex items-center justify-between text-xs font-medium text-slate-600">
                            <span>Coverage</span>
                            <span class="tabular-nums"><%= locale[:coverage] %>%</span>
                        </div>
                        <div
                            class="h-2 overflow-hidden rounded-full bg-slate-100"
                            role="progressbar"
                            aria-label="<%= locale[:name] %> coverage"
                            aria-valuemin="0"
                            aria-valuemax="100"
                            aria-valuenow="<%= locale[:coverage] %>"
                            aria-valuetext="<%= locale[:coverage] %>% coverage">
                            <div
                                class="h-full rounded-full bg-sky-600 transition-all"
                                style="width: <%= locale[:coverage] %>%">
                            </div>
                        </div>
                    </div>
                <% end %>
            <% end %>
        </div>
    </section>
<% end %>

<%# Loading the flags icons from assets %>
<%= render(partial: "lesli_assets/partials/application-lesli-icons-flags") %>
