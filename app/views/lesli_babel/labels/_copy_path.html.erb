<div class="lesli-form-field is-horizontal">
    <div class="lesli-form-label-wrapper">
        <span class="lesli-form-label">Path</span>
    </div>
    <div class="lesli-form-field-body">
        <div class="flex min-w-0 items-center gap-2 py-2" x-data="{ copied: false }">
            <code class="min-w-0 flex-1 break-all text-xs leading-5 text-slate-600" x-ref="path"><%= path %></code>
            <button
                type="button"
                class="inline-flex size-9 shrink-0 items-center justify-center rounded-lg text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-700 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-sky-500/20"
                :aria-label="copied ? 'Path copied' : 'Copy path'"
                @click="
                    navigator.clipboard.writeText($refs.path.innerText.trim());
                    copied = true;
                    setTimeout(() => copied = false, 2000)
                ">
                <span class="material-symbols text-lg leading-none" x-text="copied ? 'check' : 'content_copy'" aria-hidden="true"></span>
            </button>
        </div>
    </div>
</div>
