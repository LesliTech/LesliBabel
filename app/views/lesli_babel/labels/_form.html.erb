
<%= form_with(
    id: "lesli-babel-labels-form",
    model: @label,
    builder: LesliView::Forms::BuilderHorizontal
) do |form| %>

    <% form.fieldset("", { class: label_status_border_class(@label.status) }) do %>

        <% unless @label.new_record? %>
            <div class="mb-6 flex flex-wrap items-center justify-end gap-x-5 gap-y-2 text-sm text-slate-600" aria-label="Translation label metadata">
                <span class="<%= label_status_badge_classes(@label.status) %>" data-label-status="<%= @label.status %>">
                    <%= label_status_name(@label.status) %>
                </span>
                <span>
                    <span class="text-slate-400">Module</span>
                    <strong class="ml-1 font-medium text-slate-700"><%= @label.translation_module_code.titleize %></strong>
                </span>
                <span>
                    <span class="text-slate-400">Bucket</span>
                    <strong class="ml-1 font-medium text-slate-700"><%= @label.translation_bucket_code.titleize %></strong>
                </span>
            </div>
        <% end %>

        <% if @label.errors.any? %>
            <div class="mb-6 rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-800" role="alert">
                <p class="font-semibold">Translation label could not be updated.</p>
                <ul class="mt-2 list-disc space-y-1 pl-5">
                    <% @label.errors.full_messages.each do |message| %>
                        <li><%= message %></li>
                    <% end %>
                </ul>
            </div>
        <% end %>

        <% if @label.new_record? %>
            <%= form.field_control_select(:bucket_id, @module.buckets.order(:code).pluck(:code, :id)) %>
            <%= form.field_control_select(:prefix, LesliBabel::Label.prefixes) %>
            <%= form.field_control(:text) %>
            <%= form.field_control_textarea(:context, rows: 3, class: "!min-h-0") %>
        <% end %>

        <% unless @label.new_record? %>
            <% babel_locales.each do |locale, language| %>
                <% missing_translation = @label.public_send(locale).blank? %>
                <%= form.field_control_textarea(
                    locale,
                    label: language,
                    message: translation_field_message(@label, locale),
                    category: ("warning" if missing_translation),
                    rows: 3,
                    class: "!min-h-0",
                    placeholder: ("Missing translation" if missing_translation)
                ) %>
            <% end %>
            <hr class="my-6 border-0 border-t border-slate-200">
            <%= form.field_control_textarea(:context, rows: 3, class: "!min-h-0") %>
            <%= form.field_control_select(:status, LesliBabel::Label.statuses) %>
        <% end %>

        <hr class="my-6 border-0 border-t border-slate-200">

        <%= form.field_control_button("Save translations", icon: "save") %>

    <% end %>
<% end %>
