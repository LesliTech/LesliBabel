
<%= render(LesliView::Layout::Container.new("babel-translations-show")) do %>
    
    <%= render(LesliView::Components::Header.new(
        @label.text.titleize,
        render("copy_path", path: @label.translation_path),
        back: module_path(@label.bucket.module.id)
    )) %>

    <div class="flex min-w-0 flex-col gap-6 lg:flex-row lg:items-start">
        <%= render "module_navigation" %>

        <div class="min-w-0 flex-1">
            <%= render "form" %>
        </div>
    </div>
<% end %>
