
<%= render(LesliView::Layout::Container.new("babel-dashboard")) do %>

    <%= render(LesliView::Components::Header.new(
        "Translations dashboard",
        "Tracking #{@stats[:total_labels]} labels across #{@stats.dig(:summary, :configured_locales)} locales."
    )) do %>
        <% if web_deploy_allowed? %>
            <%= render(LesliView::Elements::Button.new(
                "Deploy",
                solid: true,
                icon: "rocket_launch",
                url: deploy_translations_path,
                method: :post
            )) %>
        <% end %>
    <% end %>

    <%= render(LesliView::Components::Toolbar.new) %>

    <section class="grid gap-3 py-6 sm:grid-cols-2 lg:grid-cols-4" aria-label="Translation catalog summary">
        <%= render "summary_card", label: "Total labels", value: @stats[:total_labels], path: labels_path %>
        <%= render "summary_card", label: "Configured locales", value: @stats.dig(:summary, :configured_locales), path: nil %>
        <%= render "summary_card", label: "Pending translations", value: @stats.dig(:summary, :pending_translations), path: nil %>
        <%= render "summary_card", label: "Global coverage", value: "#{@stats.dig(:summary, :coverage)}%", path: nil %>
    </section>

    <section class="grid gap-4 pb-6 sm:grid-cols-3" aria-label="Labels requiring attention">
        <% {
            "Need translation" => @stats.dig(:attention, :need_translation),
            "Need help" => @stats.dig(:attention, :need_help),
            "Need context" => @stats.dig(:attention, :need_context)
        }.each do |label, total| %>
            <article class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
                <p class="text-sm font-medium text-slate-500"><%= label %></p>
                <p class="mt-2 text-3xl font-semibold tabular-nums text-slate-900"><%= total %></p>
            </article>
        <% end %>
    </section>

    <section class="py-6 sm:py-8" aria-label="Translation status by locale">
        <div class="grid gap-5 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">
            <% @stats[:locales].each do |locale| %>
                <article class="flex flex-col items-center rounded-2xl border border-slate-200 bg-white p-5 text-center shadow-sm sm:p-6">
                    <svg class="mb-3 h-12 w-16" aria-hidden="true">
                        <use xlink:href="#locale-<%= locale[:code] %>"></use>
                    </svg>
                    <h2 class="text-base font-medium text-slate-700">
                        <%= locale[:name] %>
                    </h2>
                    <p class="mt-1 text-2xl font-medium tabular-nums text-slate-700"><%= locale[:coverage] %>%</p>
                    <dl class="mt-3 grid w-full grid-cols-2 gap-3 text-sm">
                        <div>
                            <dt class="text-slate-500">Completed</dt>
                            <dd class="font-semibold tabular-nums text-slate-900"><%= locale[:completed] %></dd>
                        </div>
                        <div>
                            <dt class="text-slate-500">Missing</dt>
                            <dd class="font-semibold tabular-nums text-slate-900"><%= locale[:missing] %></dd>
                        </div>
                    </dl>
                </article>
            <% end %>
        </div>
    </section>
<% end %>

<%# Loading the flags icons from assets %>
<%= render(partial: "lesli_assets/partials/application-lesli-icons-flags") %>
