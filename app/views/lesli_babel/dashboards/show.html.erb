
<%= render(LesliView::Layout::Container.new("babel-dashboard")) do %>

    <%= render(LesliView::Components::Header.new("Found #{@stats[:total_strings]} registered labels")) do %>
        <%= render(LesliView::Elements::Button.new('Deploy', solid:true, icon:'rocket_launch', url:deploy_translations_path, method: :post)) %>
    <% end %>

    <%= render(LesliView::Components::Toolbar.new) %>

    <section class="py-6 sm:py-8" aria-label="Translation status by locale">
        <div class="grid gap-5 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3 xl:grid-cols-4">
            <% @stats[:total_strings_translations].each do |locale| %>
                <article class="flex flex-col items-center rounded-2xl border border-slate-200 bg-white p-5 text-center shadow-sm sm:p-6">
                    <svg class="mb-3 h-12 w-16" aria-hidden="true">
                        <use xlink:href="#locale-<%= locale[:code] %>"></use>
                    </svg>
                    <h2 class="text-lg font-semibold text-slate-900">
                        <%= locale[:name] %>: <span class="tabular-nums"><%= locale[:total] %></span>
                    </h2>
                    <p class="mt-1 text-sm text-slate-500">
                        missing: <span class="tabular-nums"><%= @stats[:total_strings].to_i - locale[:total] %></span> translations
                    </p>
                </article>
            <% end %>
        </div>
    </section>
<% end %>

<%# Loading the flags icons from assets %>
<%= render(partial: "lesli_assets/partials/application-lesli-icons-flags") %>
